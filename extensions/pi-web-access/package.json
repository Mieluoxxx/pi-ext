{
  "name": "@moguw/pi-web-access",
  "version": "0.24.3",
  "description": "Web search, URL fetching, GitHub repo cloning, PDF extraction, YouTube video understanding, and local video analysis for Pi coding agent. Supports OpenAI, Brave, Parallel, TinyFish, Search1API, Searchinfinity, Querit, Tavily, Firecrawl, Jina, SERPdive, Kagi, Ollama, AnySearch, Bright Data SERP, SerpBase, SearXNG, Exa, Perplexity, and Gemini.",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc",
    "audit:runtime": "pnpm audit --prod"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "web-search",
    "tinyfish",
    "search1api",
    "searchinfinity",
    "querit",
    "perplexity",
    "fetch",
    "scraping"
  ],
  "author": "Nico Bailon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mieluoxxx/pi-ext.git",
    "directory": "extensions/pi-web-access"
  },
  "bugs": {
    "url": "https://github.com/Mieluoxxx/pi-ext/issues"
  },
  "homepage": "https://github.com/Mieluoxxx/pi-ext/tree/main/extensions/pi-web-access#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "*.ts",
    "CHANGELOG.md",
    "SECURITY.md",
    "banner.png",
    "pi-web-fetch-demo.mp4"
  ],
  "devDependencies": {
    "@types/turndown": "^5.0.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.16.0",
    "p-limit": "^6.1.0",
    "promise.try": "^2.0.1",
    "turndown": "^7.2.0",
    "typebox": "^1.1.38",
    "unpdf": "^1.6.2",
    "undici": "^8.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "video": "https://github.com/nicobailon/pi-web-access/raw/refs/heads/main/pi-web-fetch-demo.mp4"
  }
}
