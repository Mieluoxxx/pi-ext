{
	"name": "@moguw/pi-session-fork",
	"version": "0.1.0",
	"description": "Fork Pi sessions into Herdr panes or tabs, and run inline/outline side conversations",
	"type": "module",
	"license": "MIT",
	"private": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Mieluoxxx/pi-ext.git",
		"directory": "extensions/pi-session-fork"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"fork",
		"sessions",
		"herdr",
		"btw",
		"pane",
		"tab"
	],
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"check": "npm run typecheck && npm test",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^0.83.0",
		"@earendil-works/pi-coding-agent": "^0.83.0",
		"@earendil-works/pi-tui": "^0.83.0",
		"@types/node": "^22.19.19",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	}
}
