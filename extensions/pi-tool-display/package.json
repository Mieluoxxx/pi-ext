{
  "name": "@moguw/pi-tool-display",
  "version": "0.5.1",
  "description": "Compact tool call rendering, diff visualization, and output truncation extension for Pi coding agent. Hides, collapses, and truncates verbose tool output for cleaner TUI display.",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./tool-display-api-consumer": {
      "types": "./tool-display-api-consumer.d.ts",
      "default": "./tool-display-api-consumer.js"
    }
  },
  "files": [
    "index.ts",
    "tool-display-api-consumer.js",
    "tool-display-api-consumer.d.ts",
    "src",
    "config/config.example.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "npm run typecheck",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run test",
    "typecheck": "tsc -p tsconfig.json"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "pi-tui",
    "coding-agent",
    "tui",
    "tool-rendering",
    "tool-output",
    "diff-visualization",
    "output-truncation",
    "hide",
    "collapse",
    "truncate",
    "compact",
    "diff",
    "output-mode"
  ],
  "author": "Mieluoxxx",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mieluoxxx/pi-ext.git",
    "directory": "extensions/pi-tool-display"
  },
  "bugs": {
    "url": "https://github.com/Mieluoxxx/pi-ext/issues"
  },
  "homepage": "https://github.com/Mieluoxxx/pi-ext/tree/main/extensions/pi-tool-display#readme",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "overrides": {
    "file-type": ">=21.3.1",
    "protobufjs": "7.6.3",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@earendil-works/pi-tui": "^0.83.0",
    "@types/node": "^22.19.19",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
