{
	"name": "pi-ext",
	"version": "0.1.0",
	"private": true,
	"description": "Monorepo for @moguw Pi extension packages",
	"type": "module",
	"scripts": {
		"check": "pnpm run typecheck && pnpm run test",
		"typecheck": "pnpm -r run typecheck",
		"test": "pnpm -r run test",
		"pack:session-rename": "pnpm --filter @moguw/pi-session-rename pack --dry-run"
	}
}
