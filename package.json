{
	"name": "pi-ext",
	"version": "0.1.0",
	"private": true,
	"description": "Monorepo for @moguw Pi extension packages",
	"type": "module",
	"workspaces": [
		"extensions/*"
	],
	"scripts": {
		"check": "npm run typecheck && npm test",
		"typecheck": "npm --workspaces --if-present run typecheck",
		"test": "npm --workspaces --if-present run test",
		"pack:session-rename": "npm pack --workspace @moguw/pi-session-rename --dry-run"
	}
}
